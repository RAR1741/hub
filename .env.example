# Browser-facing (host can reach this). Used only for Supabase Auth flows.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from `npm run db:start`>

# Server-side (dev container reaches sibling containers via host.docker.internal).
# Leave unset in production — Vercel talks to hosted Supabase over the public URL.
SUPABASE_INTERNAL_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=<service_role key from `npm run db:start`>

# Student session signing secret: generate with `openssl rand -hex 32`
STUDENT_SESSION_SECRET=

# Realtime broadcast token signing (see docs/superpowers/specs/2026-08-28-realtime-broadcast-design.md).
# Local: the fixed Supabase local-stack secret, super-secret-jwt-token-with-at-least-32-characters-long.
# Prod: the "legacy JWT secret" from the Supabase dashboard. Missing/empty => route 503s, clients fall back to polling.
SUPABASE_JWT_SECRET=

# --- Onshape integration (see docs/superpowers/specs/2026-08-23-onshape-panel-integration-design.md §6) ---
ONSHAPE_CLIENT_ID=
ONSHAPE_CLIENT_SECRET=
ONSHAPE_REDIRECT_URI=
# Defaults point at real Onshape; for local dev without Onshape, point these at
# the dev mock (blocked on any Vercel deployment; see docs/setup/onshape.md) instead:
# ONSHAPE_TOKEN_URL=http://localhost:3000/api/dev/onshape-mock/oauth/token
# ONSHAPE_API_BASE_URL=http://localhost:3000/api/dev/onshape-mock
ONSHAPE_AUTHORIZATION_URL=
ONSHAPE_TOKEN_URL=
ONSHAPE_API_BASE_URL=
ONSHAPE_SCOPES=
# CI/e2e ONLY — opts the dev Onshape mock into a non-Vercel production-mode
# `next start` (e.g. CI's Playwright run). Never set this on Vercel: it has no
# effect there (VERCEL_ENV hard-blocks the mock regardless), but don't set it
# anyway.
ALLOW_ONSHAPE_MOCK=

# --- GitHub App (team sync + "Connect GitHub"). See docs/setup/github-app.md ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=        # PEM; newlines as \n
GITHUB_APP_INSTALLATION_ID=    # from the App's install page or GET /orgs/{org}/installation
GITHUB_ORG=RAR1741
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=   # optional override; default derives from the request origin

# --- Slack bot integration ---
# Slack bot OAuth token (xoxb-...) for posting messages to channels and DMs.
# Left unset in dev — Vercel injects per-environment. Generate/rotate via
# Slack app dashboard (API credentials / OAuth tokens).
SLACK_BOT_TOKEN=

# --- Mentor Google OAuth ---
# NOTE: these two do NOT go in .env.local — the Supabase CLI reads env() in
# supabase/config.toml from a `.env` file at the repo root. Put them in `.env`,
# not here. See docs/setup/google-oauth.md. (Left here only as a reminder.)
# GOOGLE_OAUTH_CLIENT_ID=      -> set in .env
# GOOGLE_OAUTH_CLIENT_SECRET=  -> set in .env

# --- Outbound email (Gmail API, see docs/setup/gmail-sending.md) ---
# Reuses GOOGLE_SA_CLIENT_EMAIL / GOOGLE_SA_PRIVATE_KEY from calendar/drive sync above.
# Must be a real Workspace mailbox the service account is delegated to send as.
HUB_MAIL_SENDER=

