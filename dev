#!/usr/bin/env bash
# Run a command inside the dev container. Nothing but Docker is needed on the host.
#
#   ./dev npm install
#   ./dev npm test
#   ./dev bash -lc "npx supabase start"
#   ./dev            # interactive shell
#
# Windows/Git Bash note: arguments containing absolute Linux paths (e.g.
# /var/run/docker.sock, /etc/hosts) can get rewritten by MSYS path translation
# before Docker ever sees them. If a command mysteriously can't find a path
# that clearly exists in the container, prefix the invocation with
# MSYS_NO_PATHCONV=1, e.g.: MSYS_NO_PATHCONV=1 ./dev cat /etc/hosts
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
COMPOSE_FILE="$ROOT_DIR/.devcontainer/docker-compose.yml"
export LOCAL_WORKSPACE_FOLDER="${LOCAL_WORKSPACE_FOLDER:-$ROOT_DIR}"

# Load per-worktree overrides (COMPOSE_PROJECT_NAME, APP_PORT, ...) if present.
[ -f "$ROOT_DIR/.env" ] && set -a && source "$ROOT_DIR/.env" && set +a

# Pin the compose project name so this script always joins the same stack
# VS Code's Dev Containers extension starts (it reads the `name:` in
# docker-compose.yml). Without this, a project name derived from the
# invoking directory could drift from VS Code's, starting a second stack
# that fights the first one for port 3000. Overridden per-worktree via
# .env.worktree so parallel git worktrees don't collide.
PROJECT_NAME="${COMPOSE_PROJECT_NAME:-team-hub}"

# Start the service if it isn't already running.
if [ -z "$(docker compose -p "$PROJECT_NAME" -f "$COMPOSE_FILE" ps -q app 2>/dev/null)" ]; then
  docker compose -p "$PROJECT_NAME" -f "$COMPOSE_FILE" up -d app
fi

if [ "$#" -eq 0 ]; then
  exec docker compose -p "$PROJECT_NAME" -f "$COMPOSE_FILE" exec app bash
fi
exec docker compose -p "$PROJECT_NAME" -f "$COMPOSE_FILE" exec -T app "$@"
